<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">

    <script>
        (function() {
            const t = localStorage.getItem('theme');
            const d = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', (t === 'dark' || (!t && d)) ? 'dark' : 'light');
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">

    {{!-- ══════════════════ NAVBAR ══════════════════════════════════ --}}
    <nav class="navbar navbar-expand-lg" id="mainNavbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span class="brand-bolt"><i class="fas fa-bolt"></i></span>
                ChargeIT
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fas fa-bars" style="color: var(--navbar-text);"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1 opacity-75"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/stations"><i class="fas fa-charging-station me-1 opacity-75"></i>Stations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/stations/search"><i class="fas fa-search me-1 opacity-75"></i>Search</a>
                    </li>
                    {{#if user.isAdmin}}
                    <li class="nav-item">
                        <a class="nav-link nav-admin-link" href="/admin">
                            <i class="fas fa-shield-alt me-1"></i>Admin
                        </a>
                    </li>
                    {{/if}}
                </ul>

                <ul class="navbar-nav align-items-center gap-1">
                    <li class="nav-item me-2">
                        <div class="theme-switch-wrapper">
                            <label class="theme-switch" for="checkbox" title="Toggle dark mode">
                                <input type="checkbox" id="checkbox" />
                                <div class="slider round"></div>
                            </label>
                        </div>
                    </li>

                    {{#if user}}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-menu-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <span class="nav-avatar">{{user.username.[0]}}</span>
                                <span class="d-none d-sm-inline">{{user.username}}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <span class="dropdown-item-text" style="font-size:0.75rem;color:var(--text-muted-color);padding:0.5rem 1rem;">
                                        Signed in as <strong style="color:var(--body-text);">{{user.username}}</strong>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/favorites"><i class="fas fa-heart me-2" style="color:var(--danger);"></i>My Favorites</a></li>
                                {{#if user.isAdmin}}
                                <li><a class="dropdown-item" href="/admin"><i class="fas fa-shield-alt me-2" style="color:#F59E0B;"></i>Admin Panel</a></li>
                                {{/if}}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="POST" action="/auth/logout" class="d-inline" id="logoutForm">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    {{else}}
                        <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
                        <li class="nav-item">
                            <a href="/auth/register" class="btn btn-primary btn-sm ms-1 px-3">Get Started</a>
                        </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    {{!-- ══════════════════ MAIN CONTENT ════════════════════════════ --}}
    <main class="flex-grow-1">
        {{{body}}}
    </main>

    {{!-- ══════════════════ FOOTER ══════════════════════════════════ --}}
    <footer class="mt-auto">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-brand">
                        <i class="fas fa-bolt"></i>ChargeIT
                    </div>
                    <p class="footer-tagline">The smart way to find, compare, and navigate to EV charging stations worldwide.</p>
                    <div class="d-flex gap-3 mt-3">
                        <span style="font-size:0.8rem;color:rgba(180,200,230,0.5);">
                            <strong style="color:var(--accent);">{{totalStations}}</strong> Stations
                        </span>
                        <span style="font-size:0.8rem;color:rgba(180,200,230,0.5);">
                            <strong style="color:#3B82F6;">{{countries}}</strong> Countries
                        </span>
                    </div>
                </div>
                <div class="col-6 col-lg-2 offset-lg-2">
                    <p class="footer-heading">Explore</p>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/stations">All Stations</a></li>
                        <li><a href="/stations/search">Search</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="footer-heading">Account</p>
                    <ul class="footer-links">
                        <li><a href="/auth/login">Login</a></li>
                        <li><a href="/auth/register">Register</a></li>
                        <li><a href="/favorites">Favorites</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <p class="footer-heading">Features</p>
                    <ul class="footer-links" style="list-style:none;padding:0;">
                        <li><i class="fas fa-leaf me-2" style="color:var(--accent);font-size:0.75rem;"></i>Eco-Friendly</li>
                        <li><i class="fas fa-shield-alt me-2" style="color:#3B82F6;font-size:0.75rem;"></i>Verified Data</li>
                        <li><i class="fas fa-users me-2" style="color:#F59E0B;font-size:0.75rem;"></i>Community</li>
                    </ul>
                </div>
            </div>
            <hr style="border-color:rgba(255,255,255,0.06);margin:2rem 0 1.5rem;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span style="font-size:0.8rem;color:rgba(180,200,230,0.4);">&copy; 2025 ChargeIT — ITE5315 Group 7 Project</span>
                <span style="font-size:0.78rem;color:rgba(0,195,106,0.5);"><i class="fas fa-leaf me-1"></i>Powering a greener future</span>
            </div>
        </div>
    </footer>

    {{!-- Scripts --}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tsparticles/cdn@3.3.0/tsparticles.bundle.min.js"></script>
    <script src="/js/main.js"></script>

    <script type="module">
        const logoutForm = document.getElementById('logoutForm');
        if (logoutForm && localStorage.getItem('chargeIT_googleSignIn') === 'true') {
            logoutForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                try {
                    const { initializeApp, getApps } = await import('https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js');
                    const { getAuth, signOut } = await import('https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js');
                    const apps = getApps();
                    const fa = apps.length > 0 ? apps[0] : initializeApp({ apiKey:"AIzaSyCYYMDnhJNf1KN44DCAPswGC-6JDJXotds", authDomain:"chargeit-cd16b.firebaseapp.com", projectId:"chargeit-cd16b" });
                    await signOut(getAuth(fa));
                } catch(e) { console.warn('Firebase sign-out skipped:', e.message); }
                localStorage.removeItem('chargeIT_googleSignIn');
                this.submit();
            });
        }
    </script>
</body>
</html>
