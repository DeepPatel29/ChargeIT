<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">

    {{!-- Prevent flash of unstyled content --}}
    <script>
        const _t = localStorage.getItem('theme');
        const _d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', (_t === 'dark' || (!_t && _d)) ? 'dark' : 'light');
    </script>
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-bolt"></i>ChargeIT
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fas fa-bars" style="color: var(--navbar-text);"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1 opacity-75"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/stations"><i class="fas fa-charging-station me-1 opacity-75"></i>Stations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/stations/search"><i class="fas fa-search me-1 opacity-75"></i>Search</a>
                    </li>
                    {{#if user.isAdmin}}
                    <li class="nav-item">
                        <a class="nav-link fw-bold" href="/admin" style="color: var(--warning) !important;">
                            <i class="fas fa-shield-alt me-1"></i>Admin
                        </a>
                    </li>
                    {{/if}}
                </ul>

                <ul class="navbar-nav align-items-center gap-1">
                    {{!-- Dark Mode Toggle --}}
                    <li class="nav-item me-2">
                        <div class="theme-switch-wrapper">
                            <label class="theme-switch" for="checkbox" title="Toggle dark mode">
                                <input type="checkbox" id="checkbox" />
                                <div class="slider round"></div>
                            </label>
                        </div>
                    </li>

                    {{#if user}}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle me-1"
                                      style="width:26px;height:26px;background:var(--accent-subtle);border:1px solid var(--accent);font-size:0.7rem;color:var(--accent);font-weight:700;">
                                    {{user.username.[0]}}
                                </span>
                                {{user.username}}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <span class="dropdown-item-text text-muted" style="font-size:0.75rem;padding:0.4rem 0.9rem;">
                                        Signed in as <strong>{{user.username}}</strong>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/favorites">
                                        <i class="fas fa-heart me-2" style="color:var(--danger);"></i>My Favorites
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="POST" action="/auth/logout" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    {{else}}
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a href="/auth/register" class="btn btn-primary btn-sm ms-1 px-3">
                                Sign Up
                            </a>
                        </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4 flex-grow-1 pb-4">
        {{{body}}}
    </main>

    <footer class="mt-5 py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-brand">
                        <i class="fas fa-bolt"></i>ChargeIT
                    </div>
                    <p style="max-width:280px;line-height:1.7;">
                        The smart way to find, compare, and navigate to EV charging stations worldwide.
                    </p>
                </div>
                <div class="col-6 col-lg-2 offset-lg-2">
                    <p class="fw-semibold mb-3" style="color:rgba(200,220,255,0.7);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;">Explore</p>
                    <ul class="list-unstyled mb-0" style="line-height:2;">
                        <li><a href="/">Home</a></li>
                        <li><a href="/stations">All Stations</a></li>
                        <li><a href="/stations/search">Search</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="fw-semibold mb-3" style="color:rgba(200,220,255,0.7);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;">Account</p>
                    <ul class="list-unstyled mb-0" style="line-height:2;">
                        <li><a href="/auth/login">Login</a></li>
                        <li><a href="/auth/register">Register</a></li>
                        <li><a href="/favorites">Favorites</a></li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <p class="mb-0">&copy; 2024 ChargeIT &mdash; ITE5315 Group 7 Project</p>
                <p class="mb-0" style="color:rgba(0,195,106,0.6);font-size:0.78rem;">
                    <i class="fas fa-leaf me-1"></i>Powering a greener future
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>

    {{!-- Google Sign-Out: only fires if user originally signed in via Google --}}
    <script type="module">
        const logoutForm = document.querySelector('form[action="/auth/logout"]');
        if (logoutForm && localStorage.getItem('chargeIT_googleSignIn') === 'true') {
            logoutForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                try {
                    const { initializeApp, getApps } = await import('https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js');
                    const { getAuth, signOut } = await import('https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js');
                    // Reuse existing app instance if already initialized, otherwise create one
                    const existingApps = getApps();
                    const firebaseApp = existingApps.length > 0
                        ? existingApps[0]
                        : initializeApp({
                            apiKey: "AIzaSyCYYMDnhJNf1KN44DCAPswGC-6JDJXotds",
                            authDomain: "chargeit-cd16b.firebaseapp.com",
                            projectId: "chargeit-cd16b"
                          });
                    await signOut(getAuth(firebaseApp));
                } catch (err) {
                    // Non-fatal — proceed with logout regardless
                    console.warn('Firebase sign-out skipped:', err.message);
                }
                localStorage.removeItem('chargeIT_googleSignIn');
                logoutForm.submit();
            });
        }
    </script>
</body>
</html>
