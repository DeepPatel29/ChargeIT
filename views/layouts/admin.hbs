<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} — ChargeIT Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">

    <script>
        const _t = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', _t);
    </script>
</head>
<body class="admin-body">

<div class="admin-wrapper">

    {{!-- ═══ SIDEBAR ═══════════════════════════════════════ --}}
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-header">
            <a href="/" class="sidebar-brand">
                <span class="brand-icon"><i class="fas fa-bolt"></i></span>
                <span>ChargeIT</span>
            </a>
            <span class="sidebar-role-badge">Admin</span>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">{{user.username.[0]}}</div>
            <div class="user-info">
                <div class="user-name">{{user.username}}</div>
                <div class="user-email">{{user.email}}</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Overview</div>
            <a href="/admin" class="sidebar-link {{#eq title 'Admin Dashboard'}}active{{/eq}}">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>

            <div class="nav-section-label mt-3">Manage</div>
            <a href="/admin/stations" class="sidebar-link {{#eq title 'Manage Stations'}}active{{/eq}}">
                <i class="fas fa-charging-station"></i>
                <span>Stations</span>
            </a>
            <a href="/admin/users" class="sidebar-link {{#eq title 'Manage Users'}}active{{/eq}}">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </a>
            <a href="/admin/price-suggestions" class="sidebar-link {{#eq title 'Crowdsourced Price Updates'}}active{{/eq}}">
                <i class="fas fa-tags"></i>
                <span>Price Suggestions</span>
                {{#if pendingSuggestions}}
                <span class="nav-badge">{{pendingSuggestions}}</span>
                {{/if}}
            </a>

            <div class="sidebar-divider"></div>

            <a href="/" class="sidebar-link" target="_blank">
                <i class="fas fa-external-link-alt"></i>
                <span>View Site</span>
            </a>

            <form method="POST" action="/auth/logout" class="mt-1">
                <button type="submit" class="sidebar-link sidebar-logout w-100">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </button>
            </form>
        </nav>

        <div class="sidebar-footer">
            <div class="theme-switch-wrapper justify-content-center">
                <i class="fas fa-sun me-2" style="font-size:0.75rem;color:var(--text-muted-color);"></i>
                <label class="theme-switch" for="admin-theme-checkbox" title="Toggle dark mode">
                    <input type="checkbox" id="admin-theme-checkbox" />
                    <div class="slider round"></div>
                </label>
                <i class="fas fa-moon ms-2" style="font-size:0.75rem;color:var(--text-muted-color);"></i>
            </div>
        </div>
    </aside>

    {{!-- ═══ MAIN CONTENT ═══════════════════════════════ --}}
    <div class="admin-content" id="adminContent">

        {{!-- Top Bar --}}
        <header class="admin-topbar">
            <div class="topbar-left">
                <button class="sidebar-toggle-btn" onclick="toggleAdminSidebar()" aria-label="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-breadcrumb">
                    <a href="/admin">Admin</a>
                    {{#unless (eq title 'Admin Dashboard')}}
                    <i class="fas fa-chevron-right mx-2" style="font-size:0.6rem;color:var(--text-muted-color);"></i>
                    <span>{{title}}</span>
                    {{/unless}}
                </div>
            </div>
            <div class="topbar-right">
                <a href="/admin/stations/add" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus me-1"></i>Quick Add
                </a>
            </div>
        </header>

        {{!-- Page Content --}}
        <main class="admin-main">
            {{{body}}}
        </main>
    </div>
</div>

{{!-- Mobile overlay --}}
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleAdminSidebar()"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
// ─── Sidebar Toggle ──────────────────────────────────────
function toggleAdminSidebar() {
    const sidebar = document.getElementById('adminSidebar');
    const content = document.getElementById('adminContent');
    const overlay = document.getElementById('sidebarOverlay');
    sidebar.classList.toggle('sidebar-collapsed');
    content.classList.toggle('content-expanded');
    overlay.classList.toggle('active');
}

// ─── Theme Toggle ────────────────────────────────────────
const adminCheckbox = document.getElementById('admin-theme-checkbox');
const currentTheme = localStorage.getItem('theme') || 'dark';
document.documentElement.setAttribute('data-theme', currentTheme);
if (currentTheme === 'dark') adminCheckbox.checked = true;

adminCheckbox.addEventListener('change', function() {
    const theme = this.checked ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
});

// ─── Active link highlight ───────────────────────────────
document.querySelectorAll('.sidebar-link').forEach(link => {
    if (link.href && link.href === window.location.href) {
        link.classList.add('active');
    }
});
</script>

{{!-- Google Sign-Out on Logout --}}
<script type="module">
    const logoutForm = document.querySelector('form[action="/auth/logout"]');
    if (logoutForm && localStorage.getItem('chargeIT_googleSignIn') === 'true') {
        logoutForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            try {
                const { initializeApp, getApps } = await import('https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js');
                const { getAuth, signOut } = await import('https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js');
                const apps = getApps();
                const firebaseApp = apps.length > 0 ? apps[0] : initializeApp({
                    apiKey: "{{{firebaseApiKey}}}",
                    authDomain: "{{{firebaseAuthDomain}}}",
                    projectId: "{{{firebaseProjectId}}}"
                });
                await signOut(getAuth(firebaseApp));
            } catch (err) {
                console.warn('Firebase sign-out skipped:', err.message);
            }
            localStorage.removeItem('chargeIT_googleSignIn');
            logoutForm.submit();
        });
    }
</script>
</body>
</html>
