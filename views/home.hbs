{{!-- ═══ HERO ══════════════════════════════════════════════════ --}}
<section class="hero-section rounded-3 mb-5">
    <div class="container position-relative" style="z-index:2;">
        <div class="row justify-content-center text-center">
            <div class="col-lg-9">
                <p class="section-label mb-3">
                    <i class="fas fa-bolt me-1"></i> Global EV Charging Network
                </p>
                <h1 class="display-4 mb-4">
                    Your Drive,<br>
                    <span style="color: var(--accent);">Empowered.</span>
                </h1>
                <p class="lead mx-auto mb-5" style="max-width:600px; color:rgba(200,220,255,0.75);">
                    Stop guessing. Start charging. Find, compare, and navigate to the
                    perfect EV charging station — wherever you are.
                </p>

                <div class="hero-search-wrap">
                    <div class="col-lg-8 mx-auto">
                        <form action="/stations/search" method="GET" class="d-flex hero-search shadow-lg" style="border-radius:12px;overflow:hidden;">
                            <input type="text" name="city"
                                   class="form-control border-0"
                                   placeholder="Search by city — Tokyo, Berlin, Mumbai..."
                                   required
                                   style="border-radius:0;">
                            <button type="submit" class="btn btn-search d-flex align-items-center gap-2">
                                <i class="fas fa-search"></i>
                                <span class="d-none d-sm-inline">Search</span>
                            </button>
                        </form>
                        <p class="mt-3" style="font-size:0.8rem;color:rgba(180,200,255,0.45);">
                            <i class="fas fa-map-marker-alt me-1" style="color:var(--accent);"></i>
                            {{totalStations}}+ stations across {{countries}}+ countries
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{{!-- ═══ STATS ══════════════════════════════════════════════════ --}}
<section class="mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(0,195,106,0.12);">
                    <i class="fas fa-charging-station" style="color:var(--accent);"></i>
                </div>
                <div class="stat-number">{{totalStations}}+</div>
                <div class="stat-label">Charging Stations</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(59,130,246,0.12);">
                    <i class="fas fa-globe" style="color:#3B82F6;"></i>
                </div>
                <div class="stat-number">{{countries}}+</div>
                <div class="stat-label">Countries Covered</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(245,158,11,0.12);">
                    <i class="fas fa-bolt" style="color:#F59E0B;"></i>
                </div>
                <div class="stat-number">24/7</div>
                <div class="stat-label">Live Availability</div>
            </div>
        </div>
    </div>
</section>

{{!-- ═══ CONFIDENCE BANNER ══════════════════════════════════════ --}}
<section class="mb-5">
    <div class="confidence-banner p-5">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <p class="section-label mb-2"><i class="fas fa-shield-alt me-1"></i>Why ChargeIT</p>
                <h2 class="text-white fw-bold mb-3" style="font-size:1.9rem;letter-spacing:-0.03em;">
                    From range anxiety to<br>
                    <span class="accent-text">complete confidence.</span>
                </h2>
                <p style="color:rgba(200,220,255,0.65);line-height:1.8;max-width:420px;font-size:0.95rem;">
                    Real-time data. Community-verified pricing. Transparent availability.
                    ChargeIT gives you everything you need to own the road.
                </p>
                <a href="/stations" class="btn btn-primary mt-3 px-4">
                    <i class="fas fa-map-marked-alt me-2"></i>Explore Stations
                </a>
            </div>
            <div class="col-md-5 text-center d-none d-md-block">
                <div style="position:relative;display:inline-block;">
                    <div style="width:160px;height:160px;border-radius:50%;background:rgba(0,195,106,0.1);border:2px solid rgba(0,195,106,0.25);display:flex;align-items:center;justify-content:center;margin:0 auto;">
                        <i class="fas fa-route" style="font-size:4rem;color:var(--accent);"></i>
                    </div>
                    <div style="position:absolute;top:-10px;right:-10px;width:48px;height:48px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px var(--accent-glow);">
                        <i class="fas fa-check" style="color:white;font-size:1.1rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{{!-- ═══ FEATURED STATIONS ══════════════════════════════════════ --}}
<section class="mb-5">
    <div class="section-header">
        <div>
            <p class="section-label mb-1"><i class="fas fa-star me-1"></i>Top Picks</p>
            <h2>Featured Stations</h2>
        </div>
        <a href="/stations" class="btn btn-outline-primary px-4">
            View All <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        {{#each featuredStations}}
        <div class="col-md-6 col-lg-4">
            <div class="card station-card h-100">
                <div style="position:relative;overflow:hidden;height:200px;">
                    <img src="{{this.imageUrl}}" class="card-img-top w-100 h-100"
                         alt="{{this.location.city}} Station"
                         style="object-fit:cover;">
                    <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 60%);"></div>
                    <div style="position:absolute;bottom:12px;left:14px;">
                        <span class="badge" style="background:rgba(0,0,0,0.5);color:white;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.15);">
                            <i class="fas fa-map-marker-alt me-1" style="color:var(--accent);"></i>
                            {{this.location.country}}
                        </span>
                    </div>
                    {{#if this.usesRenewableEnergy}}
                    <div style="position:absolute;top:12px;right:12px;">
                        <span class="badge" style="background:rgba(0,195,106,0.85);color:white;backdrop-filter:blur(8px);">
                            <i class="fas fa-leaf me-1"></i>Renewable
                        </span>
                    </div>
                    {{/if}}
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1" style="font-size:1rem;">{{this.location.city}}</h5>
                    <p class="text-muted small mb-3" style="font-size:0.78rem;">
                        <i class="fas fa-map-marker-alt me-1"></i>{{this.location.address}}
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <span class="badge bg-primary">{{this.chargerType}}</span>
                        <span class="badge bg-success">${{this.costPerKWh}}/kWh</span>
                    </div>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <div class="rating" style="font-size:0.8rem;">
                            {{#times this.rating}}
                                <i class="fas fa-star text-warning"></i>
                            {{/times}}
                            {{#lt this.rating 5}}
                                {{#times (subtract 5 this.rating)}}
                                    <i class="far fa-star" style="color:#F59E0B;opacity:0.35;"></i>
                                {{/times}}
                            {{/lt}}
                            <small class="text-muted ms-1">{{this.rating}}</small>
                        </div>
                        <a href="/stations/{{this.stationId}}" class="btn btn-outline-primary btn-sm">
                            Details <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</section>

{{!-- ═══ FEATURES ════════════════════════════════════════════════ --}}
<section class="mb-2">
    <div class="text-center mb-5">
        <p class="section-label mb-2">Built for EV Drivers</p>
        <h2 style="font-size:1.8rem;">Why Choose ChargeIT?</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon-wrap">
                    <i class="fas fa-search-location" style="color:var(--accent);"></i>
                </div>
                <h4>Smart Search</h4>
                <p>Filter by charger type, rating, and location. Find exactly what you need, not just what's nearest.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon-wrap">
                    <i class="fas fa-users" style="color:var(--accent);"></i>
                </div>
                <h4>Community Pricing</h4>
                <p>Crowd-verified pricing keeps our data accurate. Suggest edits, earn trust, drive smarter.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon-wrap">
                    <i class="fas fa-leaf" style="color:var(--accent);"></i>
                </div>
                <h4>Eco-Friendly</h4>
                <p>Filter for renewable energy stations and take the next step towards a truly green journey.</p>
            </div>
        </div>
    </div>
</section>
