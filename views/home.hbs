                        <a href="/stations/search?city=Berlin" class="hero-pill"><i class="fas fa-map-marker-alt"></i>Berlin</a>
                        <a href="/stations/search?city=Mumbai" class="hero-pill"><i class="fas fa-map-marker-alt"></i>Mumbai</a>
                        <a href="/stations/search?chargerType=DC+Fast+Charger" class="hero-pill"><i class="fas fa-bolt"></i>DC Fast</a>
