{{!-- ═══ HOME PAGE SCRIPTS ═══════════════════════════════════════════ --}}
<script>
document.addEventListener('DOMContentLoaded', function() {

    // ─── tsParticles Electric Effect ──────────────────────────────
    if (typeof tsParticles !== 'undefined') {
        tsParticles.load('tsparticles', {
            fpsLimit: 60,
            particles: {
                number: { value: 60, density: { enable: true, area: 900 } },
                color: { value: ['#00C36A', '#3B82F6', '#ffffff'] },
                shape: { type: 'circle' },
                opacity: {
                    value: 0.35,
                    animation: { enable: true, speed: 0.8, minimumValue: 0.05, sync: false }
                },
                size: {
                    value: { min: 1, max: 3 },
                    animation: { enable: true, speed: 2, minimumValue: 0.3, sync: false }
                },
                links: {
                    enable: true,
                    distance: 130,
                    color: '#00C36A',
                    opacity: 0.15,
                    width: 1
                },
                move: {
                    enable: true,
                    speed: 0.8,
                    direction: 'none',
                    random: true,
                    straight: false,
                    outModes: { default: 'out' }
                }
            },
            interactivity: {
                events: {
                    onHover: { enable: true, mode: 'grab' },
                    onClick: { enable: true, mode: 'push' }
                },
                modes: {
                    grab: { distance: 150, links: { opacity: 0.4 } },
                    push: { quantity: 3 }
                }
            },
            detectRetina: true,
            background: { color: 'transparent' }
        }).catch(function() {});
    }

    // ─── Typed.js search placeholder ──────────────────────────────
    const heroSearch = document.getElementById('heroSearch');
    if (heroSearch && typeof Typed !== 'undefined') {
        const typed = new Typed(heroSearch, {
            strings: [
                'Search by city — Tokyo...',
                'Search by city — Berlin...',
                'Search by city — Mumbai...',
                'Search by city — New York...',
                'Search by city — Sydney...'
            ],
            typeSpeed: 55,
            backSpeed: 35,
            backDelay: 1800,
            loop: true,
            attr: 'placeholder',
            bindInputFocusEvents: true
        });

        heroSearch.addEventListener('focus', function() { typed.stop(); this.placeholder = ''; });
        heroSearch.addEventListener('blur', function() {
            if (!this.value) typed.start();
        });
    }

    // ─── GSAP Hero Animation ───────────────────────────────────────
    if (typeof gsap !== 'undefined') {
        gsap.from('.hero-badge', { y: -20, opacity: 0, duration: 0.7, ease: 'power2.out' });
        gsap.from('.hero-section h1', { y: 30, opacity: 0, duration: 0.9, delay: 0.2, ease: 'power3.out' });
        gsap.from('.hero-section .lead', { y: 20, opacity: 0, duration: 0.8, delay: 0.4, ease: 'power2.out' });
        gsap.from('.hero-search-wrap', { y: 20, opacity: 0, duration: 0.8, delay: 0.6, ease: 'power2.out' });
        gsap.from('.hero-card-float', { x: 30, opacity: 0, duration: 0.7, stagger: 0.18, delay: 0.5, ease: 'power2.out' });
    }

});
</script>
