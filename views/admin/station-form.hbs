<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    {{#if isEdit}}Edit Station{{else}}Add New Station{{/if}}
                </h4>
                <a href="/admin/stations" class="btn btn-sm btn-light text-primary">Cancel</a>
            </div>
            <div class="card-body">
                {{#if error}}
                    <div class="alert alert-danger">{{error}}</div>
                {{/if}}

                <form action="{{#if isEdit}}/admin/stations/edit/{{station._id}}{{else}}/admin/stations/add{{/if}}" method="POST">
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Station ID</label>
                            <input type="text" name="stationId" class="form-control" value="{{station.stationId}}" 
                                   {{#if isEdit}}readonly{{else}}required placeholder="e.g. EVS00999" pattern="^EVS\d{5}$"{{/if}}>
                            {{#unless isEdit}}<div class="form-text">Format: EVSxxxxx</div>{{/unless}}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Operator</label>
                            <input type="text" name="stationOperator" class="form-control" value="{{station.stationOperator}}" required>
                        </div>
                    </div>

                    <h5 class="mt-4 mb-3 border-bottom pb-2">Location</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Address</label>
                            <input type="text" name="address" class="form-control" value="{{station.location.address}}" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">City</label>
                            <input type="text" name="city" class="form-control" value="{{station.location.city}}" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Country</label>
                            <input type="text" name="country" class="form-control" value="{{station.location.country}}" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Latitude</label>
                            <input type="number" step="any" name="lat" class="form-control" value="{{station.location.geo.lat}}" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Longitude</label>
                            <input type="number" step="any" name="lng" class="form-control" value="{{station.location.geo.lng}}" required>
                        </div>
                    </div>

                    <h5 class="mt-4 mb-3 border-bottom pb-2">Details</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Charger Type</label>
                            <select name="chargerType" class="form-select" required>
                                <option value="AC Level 1">AC Level 1</option>
                                <option value="AC Level 2">AC Level 2</option>
                                <option value="DC Fast Charger">DC Fast Charger</option>
                                <option value="Tesla Supercharger">Tesla Supercharger</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cost per kWh ($)</label>
                            <input type="number" step="0.01" name="costPerKWh" class="form-control" value="{{station.costPerKWh}}" required>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            {{#if isEdit}}Update Station{{else}}Create Station{{/if}}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>