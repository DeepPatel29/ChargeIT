<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2><i class="fas fa-users me-2"></i>Manage Users</h2>
    
    <div class="d-flex align-items-center gap-2">
        {{!-- Search Form --}}
        <form action="/admin/users" method="GET" class="d-flex">
            <input class="form-control me-2" type="search" name="search" placeholder="Username or Email..." value="{{searchQuery}}" aria-label="Search">
            <button class="btn btn-outline-success" type="submit">
                <i class="fas fa-search"></i>
            </button>
            {{#if searchQuery}}
                <a href="/admin/users" class="btn btn-outline-secondary ms-2" title="Clear Search">
                    <i class="fas fa-times"></i>
                </a>
            {{/if}}
        </form>

        <a href="/admin/users/add" class="btn btn-success text-nowrap">
            <i class="fas fa-user-plus me-2"></i>Add User
        </a>
        <a href="/admin" class="btn btn-secondary text-nowrap">Back</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if users.length}}
                        {{#each users}}
                        <tr>
                            <td>{{this.username}}</td>
                            <td>{{this.email}}</td>
                            <td>
                                {{#if this.isAdmin}}
                                    <span class="badge bg-danger">Admin</span>
                                {{else}}
                                    <span class="badge bg-info">User</span>
                                {{/if}}
                            </td>
                            <td>{{formatDate this.createdAt}}</td>
                            <td class="text-end">
                                <form action="/admin/users/toggle-role/{{this._id}}" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm {{#if this.isAdmin}}btn-outline-secondary{{else}}btn-outline-primary{{/if}} me-1" 
                                            title="{{#if this.isAdmin}}Revoke Admin{{else}}Make Admin{{/if}}">
                                        <i class="fas {{#if this.isAdmin}}fa-user-slash{{else}}fa-user-shield{{/if}}"></i>
                                    </button>
                                </form>

                                {{#unless this.isAdmin}}
                                <form action="/admin/users/delete/{{this._id}}" method="POST" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Delete User">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                                {{/unless}}
                            </td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No users found matching "{{searchQuery}}"
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>
</div>