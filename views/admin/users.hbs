<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Manage Users</h2>
    <div>
        <a href="/admin/users/add" class="btn btn-success me-2">
            <i class="fas fa-user-plus me-2"></i>Add New User
        </a>
        <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                    <tr>
                        <td>{{this.username}}</td>
                        <td>{{this.email}}</td>
                        <td>
                            {{#if this.isAdmin}}
                                <span class="badge bg-danger">Admin</span>
                            {{else}}
                                <span class="badge bg-info">User</span>
                            {{/if}}
                        </td>
                        <td>{{formatDate this.createdAt}}</td>
                        <td class="text-end">
                            {{!-- Toggle Role Button --}}
                            <form action="/admin/users/toggle-role/{{this._id}}" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm {{#if this.isAdmin}}btn-outline-secondary{{else}}btn-outline-primary{{/if}} me-1" 
                                        title="{{#if this.isAdmin}}Revoke Admin{{else}}Make Admin{{/if}}">
                                    <i class="fas {{#if this.isAdmin}}fa-user-slash{{else}}fa-user-shield{{/if}}"></i>
                                </button>
                            </form>

                            {{!-- Delete Button (Only for non-admins for safety, or you can allow all) --}}
                            {{#unless this.isAdmin}}
                            <form action="/admin/users/delete/{{this._id}}" method="POST" class="d-inline" 
                                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <button type="submit" class="btn btn-sm btn-danger" title="Delete User">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            {{/unless}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>