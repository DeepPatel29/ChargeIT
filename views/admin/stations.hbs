<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2><i class="fas fa-charging-station me-2"></i>Manage Stations</h2>
    
    <div class="d-flex align-items-center gap-2">
        {{!-- Search & Filter Form --}}
        <form action="/admin/stations" method="GET" class="d-flex gap-2">
            
            {{!-- Filter Dropdown --}}
            <select name="type" class="form-select" style="width: auto; min-width: 150px;">
                <option value="">All Charger Types</option>
                {{#each chargerTypes}}
                    <option value="{{this}}" {{#eq this ../filterType}}selected{{/eq}}>{{this}}</option>
                {{/each}}
            </select>

            {{!-- Search Input --}}
            <div class="input-group">
                <input class="form-control" type="search" name="search" placeholder="ID, City, or Operator..." value="{{searchQuery}}" aria-label="Search">
                <button class="btn btn-outline-success" type="submit">
                    <i class="fas fa-search"></i>
                </button>
            </div>

            {{#if (or searchQuery filterType)}}
                <a href="/admin/stations" class="btn btn-outline-secondary" title="Clear Filters">
                    <i class="fas fa-times"></i>
                </a>
            {{/if}}
        </form>

        <a href="/admin/stations/add" class="btn btn-success text-nowrap">
            <i class="fas fa-plus me-2"></i>Add Station
        </a>
        <a href="/admin" class="btn btn-secondary text-nowrap">Back</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>City</th>
                        <th>Operator</th>
                        <th>Type</th>
                        <th>Cost/kWh</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if stations.length}}
                        {{#each stations}}
                        <tr>
                            <td><strong>{{this.stationId}}</strong></td>
                            <td>{{this.location.city}}</td>
                            <td>{{this.stationOperator}}</td>
                            <td><span class="badge bg-secondary">{{this.chargerType}}</span></td>
                            <td>${{this.costPerKWh}}</td>
                            <td class="text-end">
                                <a href="/admin/stations/edit/{{this._id}}" class="btn btn-sm btn-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="/admin/stations/delete/{{this._id}}" method="POST" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this station?');">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No stations found matching your criteria.
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>
    
    {{!-- Pagination Footer --}}
    {{#if (gt totalPages 1)}}
    <div class="card-footer bg-white py-3">
        <nav aria-label="Station pagination">
            <ul class="pagination justify-content-center mb-0">
                
                {{!-- Previous Button --}}
                <li class="page-item {{#eq currentPage 1}}disabled{{/eq}}">
                    <a class="page-link" href="?page={{subtract currentPage 1}}{{../paginationQuery}}">Previous</a>
                </li>

                {{!-- Current Page Indicator --}}
                <li class="page-item disabled">
                    <span class="page-link text-muted">
                        Page {{currentPage}} of {{totalPages}}
                    </span>
                </li>

                {{!-- Next Button --}}
                <li class="page-item {{#eq currentPage totalPages}}disabled{{/eq}}">
                    <a class="page-link" href="?page={{add currentPage 1}}{{../paginationQuery}}">Next</a>
                </li>

            </ul>
        </nav>
    </div>
    {{/if}}
</div>