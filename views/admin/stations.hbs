<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-charging-station me-2"></i>Manage Stations</h2>
    <div>
        <a href="/admin" class="btn btn-secondary me-2">Dashboard</a>
        <a href="/admin/stations/add" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Station</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>City</th>
                        <th>Address</th>
                        <th>Type</th>
                        <th>Operator</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each stations}}
                    <tr>
                        <td><code>{{this.stationId}}</code></td>
                        <td>{{this.location.city}}</td>
                        <td>{{this.location.address}}</td>
                        <td>{{this.chargerType}}</td>
                        <td>{{this.stationOperator}}</td>
                        <td class="text-end">
                            <a href="/admin/stations/edit/{{this._id}}" class="btn btn-sm btn-warning me-1">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="/admin/stations/delete/{{this._id}}" method="POST" class="d-inline"
                                  onsubmit="return confirm('Delete this station? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>