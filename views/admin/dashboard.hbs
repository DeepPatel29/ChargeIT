<div class="row mb-4">
    <div class="col-md-12">
        <h2 class="mb-3"><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Total Stations</h6>
                        <h2 class="my-2">{{stationCount}}</h2>
                    </div>
                    <i class="fas fa-charging-station fa-3x opacity-50"></i>
                </div>
                <a href="/admin/stations" class="text-white text-decoration-none small">Manage Stations &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Total Users</h6>
                        <h2 class="my-2">{{userCount}}</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
                <a href="/admin/users" class="text-white text-decoration-none small">Manage Users &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-dark bg-warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Price Updates</h6>
                        <h2 class="my-2">{{pendingSuggestions}}</h2>
                    </div>
                    <i class="fas fa-tags fa-3x opacity-50"></i>
                </div>
                <a href="/admin/price-suggestions" class="text-dark text-decoration-none small">Review Suggestions &rarr;</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0">Recently Added Stations</h5>
            </div>
            <ul class="list-group list-group-flush">
                {{#each recentStations}}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{this.location.city}}</strong>
                            <div class="small text-muted">{{this.stationId}}</div>
                        </div>
                        <span class="badge bg-secondary">{{this.chargerType}}</span>
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0">Newest Users</h5>
            </div>
            <ul class="list-group list-group-flush">
                {{#each recentUsers}}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{this.username}}</strong>
                            <div class="small text-muted">{{this.email}}</div>
                        </div>
                        {{#if this.isAdmin}}
                            <span class="badge bg-danger">Admin</span>
                        {{else}}
                            <span class="badge bg-info">User</span>
                        {{/if}}
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>
</div>