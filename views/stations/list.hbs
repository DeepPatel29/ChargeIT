<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-charging-station me-2"></i>All Charging Stations</h1>
    <a href="/stations/search" class="btn btn-primary">
        <i class="fas fa-search me-2"></i>Advanced Search
    </a>
</div>

<!-- Stats -->
<div class="row mb-4">
    <div class="col-12">
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Showing {{stations.length}} of {{totalStations}} stations worldwide
        </div>
    </div>
</div>

<!-- Stations Grid -->
<div class="row g-4">
    {{#each stations}}
    <div class="col-md-6 col-lg-4">
        <div class="card station-card h-100 shadow-sm">
            <img src="{{this.imageUrl}}" class="card-img-top" alt="{{this.location.city}} Station" 
                 style="height: 200px; object-fit: cover;">
            <div class="card-body">
                <h5 class="card-title">{{this.location.city}}, {{this.location.country}}</h5>
                <p class="card-text text-muted small mb-2">
                    <i class="fas fa-map-marker-alt me-1"></i>{{this.location.address}}
                </p>
                
                <div class="station-badges mb-3">
                    <span class="badge bg-primary">{{this.chargerType}}</span>
                    <span class="badge bg-success">${{this.costPerKWh}}/kWh</span>
                    {{#if this.usesRenewableEnergy}}
                        <span class="badge bg-info">Renewable Energy</span>
                    {{/if}}
                </div>
                
                <div class="station-info mb-3">
                    <div class="row small text-muted">
                        <div class="col-6">
                            <i class="fas fa-bolt me-1"></i>
                            {{this.chargingCapacityKW}}kW
                        </div>
                        <div class="col-6">
                            <i class="fas fa-car me-1"></i>
                            {{this.parkingSpots}} spots
                        </div>
                        <div class="col-6">
                            <i class="fas fa-users me-1"></i>
                            {{this.usageStats.avgUsersPerDay}}/day
                        </div>
                        <div class="col-6">
                            <i class="fas fa-road me-1"></i>
                            {{this.distanceToCityKm}}km
                        </div>
                    </div>
                </div>
                
                <div class="d-flex justify-content-between align-items-center">
                    <div class="rating">
                        {{#times this.rating}}
                            <i class="fas fa-star text-warning small"></i>
                        {{/times}}
                        {{#lt this.rating 5}}
                            {{#times (subtract 5 this.rating)}}
                                <i class="far fa-star text-warning small"></i>
                            {{/times}}
                        {{/lt}}
                        <small class="text-muted ms-1">({{this.reviews.length}} reviews)</small>
                    </div>
                    <a href="/stations/{{this.stationId}}" class="btn btn-outline-primary btn-sm">
                        Details <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>

<!-- Pagination -->
{{#if (gt totalPages 1)}}
<nav class="mt-5">
    <ul class="pagination justify-content-center">
        {{#if (gt currentPage 1)}}
            <li class="page-item">
                <a class="page-link" href="?page={{subtract currentPage 1}}">Previous</a>
            </li>
        {{/if}}
        
        {{#times totalPages}}
            <li class="page-item {{#eq this ../currentPage}}active{{/eq}}">
                <a class="page-link" href="?page={{this}}">{{this}}</a>
            </li>
        {{/times}}
        
        {{#if (lt currentPage totalPages)}}
            <li class="page-item">
                <a class="page-link" href="?page={{add currentPage 1}}">Next</a>
            </li>
        {{/if}}
    </ul>
</nav>
{{/if}}