<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card text-center" style="border-radius:20px;padding:1rem;">
                <div class="card-body py-5 px-4">
                    <div style="width:80px;height:80px;border-radius:50%;background:rgba(239,68,68,0.1);border:2px solid rgba(239,68,68,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
                        <i class="fas fa-exclamation-triangle" style="font-size:2rem;color:#EF4444;"></i>
                    </div>

                    <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:0.5rem;">{{title}}</h2>
                    <p style="color:var(--text-muted-color);margin-bottom:1rem;font-size:0.95rem;">{{message}}</p>

                    {{#if hint}}
                    <div class="alert alert-info mb-4" style="font-size:0.82rem;text-align:left;">
                        <i class="fas fa-lightbulb me-2"></i>{{hint}}
                    </div>
                    {{/if}}

                    {{#if (eq title 'Access Denied')}}
                    <div class="alert mb-4" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);color:#D97706;font-size:0.82rem;text-align:left;">
                        <i class="fas fa-key me-2"></i>
                        <strong>Admin Setup:</strong> Visit <code>/auth/setup-admin?secret=YOUR_ADMIN_SECRET</code> while logged in to grant admin access.
                    </div>
                    {{/if}}

                    <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
                        <a href="/" class="btn btn-primary px-4">
                            <i class="fas fa-home me-2"></i>Go Home
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-arrow-left me-2"></i>Go Back
                        </button>
                        <a href="/auth/login" class="btn btn-outline-primary px-4">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
